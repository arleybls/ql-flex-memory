; romload helper stub - two entries, called from SuperBASIC with CALL
;   CALL pb,   name_ptr, result_ptr  -> read 64-byte file header
;   CALL pb+4, result_ptr            -> store sysvars base (MT.INF)
; result layout for entry 0: +0 error long (0 = ok), +4..+67 header
        org     0
        bra.w   hd_read         ; +0
        bra.w   sysinf          ; +4

hd_read:
        movea.l d1,a0           ; a0 = filename (word len + chars)
        movea.l d2,a5           ; a5 = result block
        moveq   #1,d0           ; IO.OPEN
        moveq   #0,d1           ; this job
        moveq   #1,d3           ; old file, shared read
        trap    #2
        move.l  d0,(a5)
        bne.s   hdone           ; open failed - error stored
        lea     4(a5),a1        ; header buffer
        moveq   #$47,d0         ; FS.HEADR
        moveq   #64,d2          ; buffer length
        moveq   #-1,d3          ; timeout: forever
        trap    #3
        move.l  d0,(a5)
        moveq   #2,d0           ; IO.CLOSE
        trap    #2
hdone:  moveq   #0,d0           ; never raise a BASIC error
        rts

sysinf: movea.l d1,a5
        moveq   #0,d0           ; MT.INF
        trap    #1
        move.l  a0,(a5)
        moveq   #0,d0
        rts
