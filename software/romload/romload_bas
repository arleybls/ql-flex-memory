100 REMark ==================================================
110 REMark  QL Flex - Level-0 pseudo-ROM loader
120 REMark  Loads an extension-ROM image into the unclaimed
130 REMark  top window of a standalone top-config card, so a
140 REMark  warm RESET makes the QDOS ROM scan link it.
150 REMark  Stock SuperBASIC only. See docs/romload-plan.md.
160 REMark  (C) 2026 Arley Silveira - CERN-OHL-S v2
170 REMark ==================================================
180 magic = 1257308161 : REMark $4AFB0001 extension-ROM flag
190 pb = 0 : sysbase = 163840 : ws = 0 : we = 0
200 PRINT "QL FLEX - pseudo-ROM loader (Level 0)"
210 PRINT
220 make_stub
230 CALL pb+4, pb+220 : sysbase = PEEK_L(pb+220)
240 ramt = PEEK_L(sysbase+32) : REMark sysvar SV_RAMT
250 PRINT "QDOS RAM top : $"; hx$(ramt,8)
260 detect_win
270 IF ws = 0 THEN no_window
280 PRINT "Card window  : $"; hx$(ws,8); " - $"; hx$(we-1,8); win$(ws,we)
290 IF ws <> 786432 AND ws <> 819200 THEN PRINT "WARNING: unusual window start - no known config."
300 REMark $C0000 and $C8000 are both 16K-aligned, so loading
310 REMark at the window start needs no extra alignment step
320 f$ = "" : INPUT "ROM image file (e.g. mdv1_tk2_rom) ? "; f$
330 IF LEN(f$) = 0 OR LEN(f$) > 40 THEN STOP
340 hdr_read f$
350 IF PEEK_L(pb+220) <> 0 THEN PRINT "Cannot read file: QDOS error "; PEEK_L(pb+220) : STOP
360 hlen = PEEK_L(pb+224)
370 dlen = hlen - 64 : REMark VERIFY: header length field is
380 REMark   believed to include the 64-byte header itself
390 IF dlen < 1 OR dlen > 262144 THEN PRINT "Implausible image size "; dlen; " - aborting." : STOP
400 PRINT "Image size   : "; dlen; " bytes ("; INT((dlen+16383)/16384); " x 16K slot(s))"
410 IF dlen > we - ws THEN PRINT "Image does not fit the window - aborting." : STOP
420 PRINT "Loading at $"; hx$(ws,8); "..."
430 LBYTES f$, ws
440 IF PEEK_L(ws) = magic
450   PRINT "Extension ROM header ($4AFB0001) found."
460   rom_name
470 ELSE
480   PRINT "WARNING: no $4AFB0001 header at the image start."
490   PRINT "The QDOS ROM scan will IGNORE this image."
500 END IF
510 PRINT
520 PRINT "Done. Press RESET now (warm reset, keep power on):"
530 PRINT "QDOS rescans $C0000 in 16K steps and links the ROM."
540 PRINT "A cold start (power off) clears the image."
550 STOP
560 :
570 DEFine PROCedure no_window
580   PRINT "No unclaimed RAM window found."
590   PRINT "The card must be in a top config (+256K/+192K/"
600   PRINT "+128K) and installed standalone. If it is stacked,"
610   PRINT "QDOS owns the window and Level 0 does not apply"
620   PRINT "(see docs/improvements.md)."
630   STOP
640 END DEFine
650 :
660 REMark helper stub: +0 read 64-byte file header, +4 MT.INF
670 REMark source in the assembly listing; assembled with vasm
680 DEFine PROCedure make_stub
690   LOCal i, w
700   pb = RESPR(320)
710   RESTORE 990
720   FOR i = 0 TO 28 : READ w : POKE_W pb+2*i, w
730 END DEFine
740 :
750 REMark read file header: name to pb+160, result at pb+220
760 DEFine PROCedure hdr_read(n$)
770   LOCal i
780   POKE_W pb+160, LEN(n$)
790   FOR i = 1 TO LEN(n$) : POKE pb+161+i, CODE(n$(i))
800   CALL pb, pb+160, pb+220
810 END DEFine
820 :
830 REMark print the ROM name if the header points at one
840 DEFine PROCedure rom_name
850   LOCal o, l, i, c, n$
860   o = PEEK_W(ws+4) : REMark VERIFY: word ptr to name, base-relative
870   IF o && 1 THEN RETurn
880   IF o < 6 OR o > 16382 THEN RETurn
890   l = PEEK_W(ws+o)
900   IF l < 1 OR l > 40 THEN RETurn
910   n$ = ""
920   FOR i = 1 TO l
930     c = PEEK(ws+o+1+i)
940     IF c < 32 OR c > 126 THEN RETurn
950     n$ = n$ & CHR$(c)
960   END FOR i
970   PRINT "ROM name     : "; n$
980 END DEFine
985 :
990 DATA 24576, 6, 24576, 40, 8257, 10818, 28673, 29184, 30209, 20034
992 DATA 10880, 26130, 17389, 4, 28743, 29760, 30463, 20035, 10880, 28674
994 DATA 20034, 28672, 20085, 10817, 28672, 20033, 10888, 28672, 20085
996 :
1000 REMark ---- window probe (same approach as memtest) ----
1010 DEFine FuNction blk_ram(a)
1020   LOCal s1, s2, ok
1030   s1 = PEEK(a) : s2 = PEEK(a+16384)
1040   POKE a,85 : POKE a+16384,170
1050   ok = (PEEK(a) = 85) AND (PEEK(a+16384) = 170)
1060   IF ok THEN POKE a,170 : POKE a+16384,85 : ok = (PEEK(a) = 170) AND (PEEK(a+16384) = 85)
1070   POKE a,s1 : POKE a+16384,s2
1080   RETurn ok
1090 END DEFine
1100 :
1110 DEFine PROCedure detect_win
1120   LOCal a, rt
1130   ws = 0 : we = 0
1140   rt = PEEK_L(sysbase+32)
1150   a = rt : IF a < 262144 THEN a = 262144
1160   REPeat find_start
1170     IF a >= 1048576 THEN EXIT find_start
1180     IF blk_ram(a) THEN ws = a : EXIT find_start
1190     a = a + 32768
1200   END REPeat find_start
1210   IF ws = 0 THEN RETurn
1220   we = ws + 32768
1230   REPeat find_end
1240     IF we >= 1048576 THEN EXIT find_end
1250     IF NOT blk_ram(we) THEN EXIT find_end
1260     we = we + 32768
1270   END REPeat find_end
1280 END DEFine
1290 :
1300 DEFine FuNction win$(s, e)
1310   IF s = 786432 AND e = 1048576 THEN RETurn " (+256K)"
1320   IF s = 786432 AND e = 983040 THEN RETurn " (+192K)"
1330   IF s = 786432 AND e = 917504 THEN RETurn " (+128K)"
1340   IF s = 819200 AND e = 1048576 THEN RETurn " (+256K TRUMP)"
1350   IF s = 819200 AND e = 983040 THEN RETurn " (+192K TRUMP)"
1360   IF s = 819200 AND e = 917504 THEN RETurn " (+128K TRUMP)"
1370   RETurn ""
1380 END DEFine
1390 :
1400 DEFine FuNction hx$(vin, nd)
1410   LOCal h$, i, d, v : REMark params BY REFERENCE - never modify vin
1420   h$ = "" : v = vin
1430   FOR i = 1 TO nd
1440     d = v - 16 * INT(v/16)
1450     IF d < 10 THEN h$ = CHR$(48+d) & h$ : ELSE h$ = CHR$(55+d) & h$
1460     v = INT(v/16)
1470   END FOR i
1480   RETurn h$
1490 END DEFine
