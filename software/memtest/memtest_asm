; =====================================================================
; QL Flex Memory Expansion - RAM test core
; (C) 2026 Arley Silveira - CERN-OHL-S v2
; 68008 machine code, position independent. Assemble with vasm:
;   vasmm68k_mot -Fbin -m68008 -no-opt -o memtest_bin memtest_asm
; Loaded from SuperBASIC (memtest_bas) with LBYTES, driven with CALL.
;
; Entry points (offsets are fixed - do not reorder the header):
;   base+0  safe test    CALL base,mode,start,end,flags,result
;   base+4  destructive  CALL base+4,start,end,flags
;   base+8  long 'QFMT' magic, base+12 word version
;   base+16 system info  CALL base+16,result
;           stores the system-variables base (from MT.INF) as a long at
;           'result'. $28000 on a standard QL; Minerva moves it to
;           $30000 in dual-screen mode, and SMSQ/E puts it elsewhere -
;           the BASIC front-end uses this to adapt/refuse.
;
; CALL parameters arrive in D1,D2,D3,... (SuperBASIC convention).
;   mode   : 0 = QDOS-safe buffer test, 1 = unmanaged window test
;   start  : first address of the range under test
;   end    : end of range (exclusive)
;   flags  : bits 0-7 = number of passes (0 -> 1)
;            bit 8    = skip retention delay (for emulator runs)
;   result : address of 64-byte result block (must be even)
;
; Result block layout (all longs):
;   +0  fail bitmap, bit n-1 set = test n failed (0 = all passed)
;   +4  first failing address
;   +8  expected byte
;   +12 actual byte
;   +16 failing test number (1-5, 0 = none)
;   +20 passes completed
;   +24 bytes tested
;   +28 test currently running (1-5)
;   +32 done flag (1 = run finished)
;   +36 INPUT: progress overlay enable - any address inside the MODE 4
;       frame buffer ($20000-$27C00) turns the centred panel on
;   +40 internal: panel drawn flag
;   +44..+60 per-test fail counters (5 longs, one per test, counted
;       across all passes - the suite no longer stops at a failure)
;   +64 pass target (set by the core from the flags byte)
;   +68 internal: last drawn bar fill
;   +72 internal: last drawn pass/test state
;   +76 presentation: 0 = safe (white panel border), 1 = destructive
;       (red border, plus the one-line test list on text row 7)
; The result block is 80 bytes.
;
; Tests: 1 data bus (walking 1/0)    2 address bus (power-of-2 offsets)
;        3 aliasing (4K page tags)   4 March C-
;        5 checkerboard + retention delay
; All tests are byte-wide: the 68008 has an 8-bit external data bus.
;
; The destructive entry enters supervisor mode, masks interrupts,
; relocates itself to $30000 (base 128K RAM, outside any expansion
; window) so the whole window can be tested, reports directly on the
; MODE 4 screen at $20000 and never returns - reset the QL afterwards.
; =====================================================================

VERSION   equ     4
ERR_IPAR  equ     -15           ; QDOS 'bad parameter'
RELOC     equ     $30000        ; destructive-mode copy target
DSTACK    equ     $38000        ; destructive-mode supervisor stack
DRESULT   equ     $28480        ; destructive-mode result block
SCREEN    equ     $20000        ; MODE 4 frame buffer
CODELEN   equ     code_end-__start
LISTROW   equ     7             ; text row holding the one-line test list
LISTBASE  equ     SCREEN+LISTROW*1024+4   ; centres the 60-column line
CHUNK     equ     $8000         ; sweep slice between spinner updates
CHK       equ     $01           ; tick glyph (not an ASCII character)

__start:
        bra.w   safe_entry      ; +0
        bra.w   destr_entry     ; +4
        dc.b    'QFMT'          ; +8  magic
        dc.w    VERSION         ; +12
        dc.w    0               ; +14 pad
        bra.w   info_entry      ; +16

; ---------------------------------------------------------------------
; Info entry: D1 = address to store the system-variables base (long),
; obtained from the OS with MT.INF (TRAP #1, D0=0, returns A0).
; ---------------------------------------------------------------------
info_entry:
        movem.l d1-d2/a0-a1,-(sp)
        tst.l   d1
        beq     .bad
        btst    #0,d1
        bne     .bad
        movea.l d1,a1
        moveq   #0,d0           ; MT.INF
        trap    #1
        move.l  a0,(a1)
        movem.l (sp)+,d1-d2/a0-a1
        moveq   #0,d0
        rts
.bad:   movem.l (sp)+,d1-d2/a0-a1
        moveq   #ERR_IPAR,d0
        rts

; ---------------------------------------------------------------------
; Safe entry: runs the suite over [D2,D3) without touching anything
; else. Returns D0=0 (results in the block) or ERR_IPAR on bad params.
; ---------------------------------------------------------------------
safe_entry:
        movem.l d1-d7/a0-a6,-(sp)
        cmpi.l  #2,d1           ; mode 0/1 only
        bhs     .bad
        cmpi.l  #$20000,d2      ; below the screen is ROM/IO, never RAM
        blo     .bad            ; (catches RESPR wrapping down to 0)
        cmp.l   d2,d3           ; end must be > start
        bls     .bad
        tst.l   d5              ; result block required
        beq     .bad
        btst    #0,d5           ; and even
        bne     .bad
        movea.l d2,a2           ; a2 = start
        movea.l d3,a3           ; a3 = end
        movea.l d5,a4           ; a4 = result block
        move.l  d4,d7           ; d7 = flags
        bsr     clr_result
        clr.l   40(a4)          ; panel not drawn yet
        clr.l   76(a4)          ; white border (safe modes)
        moveq   #0,d6           ; d6 = pass count (0 -> 1)
        move.b  d7,d6
        bne     .pok
        moveq   #1,d6
.pok:   move.l  d6,64(a4)       ; pass target for the panel
.ploop: bsr     run_suite       ; runs all 5 tests, recording failures
        addq.l  #1,20(a4)
        subq.w  #1,d6
        bne     .ploop
        moveq   #0,d0           ; overlay: TESTS FINISHED / PRESS ENTER
        bsr     prog_done
        clr.l   28(a4)
        move.l  #1,32(a4)
        movem.l (sp)+,d1-d7/a0-a6
        moveq   #0,d0
        rts
.bad:   movem.l (sp)+,d1-d7/a0-a6
        moveq   #ERR_IPAR,d0
        rts

; clear result block (a4), record window size. +36 (overlay enable) and
; +40 (panel flag) are the caller's business; fail counters are reset.
clr_result:
        movem.l d0/a0,-(sp)
        movea.l a4,a0
        moveq   #8,d0
.c:     clr.l   (a0)+
        dbra    d0,.c           ; +0..+35
        addq.l  #8,a0           ; skip +36/+40
        moveq   #4,d0
.c2:    clr.l   (a0)+
        dbra    d0,.c2          ; +44..+63 fail counters
        move.l  a3,d0
        sub.l   a2,d0
        move.l  d0,24(a4)
        movem.l (sp)+,d0/a0
        rts

; ---------------------------------------------------------------------
; run_suite: run ALL tests 1..5 over a2/a3, recording every failure
; (bitmap + per-test counters; first failure's details kept).
; In:  a2 start, a3 end, a4 result block, d7 flags
; Out: d0 = 0 all passed, 1 = at least one test failed
; ---------------------------------------------------------------------
run_suite:
        movem.l d4-d6/a1,-(sp)
        moveq   #1,d4           ; test number
        lea     ttab(pc),a1
.next:  move.w  (a1)+,d5
        beq     .fin
        move.l  d4,28(a4)
        lea     ttab(pc),a0
        adda.w  d5,a0
        movem.l d4-d5/a1,-(sp)
        jsr     (a0)
        movem.l (sp)+,d4-d5/a1
        tst.l   d0
        beq     .tick
        bsr     record_fail
        move.w  d4,d5           ; per-test fail counter++
        subq.w  #1,d5
        lsl.w   #2,d5
        lea     44(a4),a0
        addq.l  #1,0(a0,d5.w)
.tick:  moveq   #1,d0           ; bar to test/5 exactly
        moveq   #1,d1
        bsr     prog_frac
        addq.w  #1,d4
        bra     .next
.fin:   moveq   #0,d0
        tst.l   (a4)
        beq     .out
        moveq   #1,d0
.out:   movem.l (sp)+,d4-d6/a1
        rts

; record a failure: d1=addr d2=expected d3=actual d4=test number
; (only the first failure's details are kept; bitmap always updated)
record_fail:
        movem.l d0/d5,-(sp)
        tst.l   16(a4)
        bne     .bit
        move.l  d1,4(a4)
        move.l  d2,8(a4)
        move.l  d3,12(a4)
        move.l  d4,16(a4)
.bit:   moveq   #1,d0
        move.w  d4,d5
        subq.w  #1,d5
        lsl.l   d5,d0
        or.l    d0,(a4)
        movem.l (sp)+,d0/d5
        rts

; ---------------------------------------------------------------------
; Destructive entry: D1=start D2=end D3=flags. Never returns.
; ---------------------------------------------------------------------
destr_entry:
        cmpi.l  #$40000,d1      ; window must lie in expansion space
        blo     .bad
        cmp.l   d1,d2           ; end must be > start
        bls     .bad
        trap    #0              ; supervisor mode (QDOS)
        move.w  #$2700,sr       ; interrupts off
        lea     __start(pc),a0  ; copy ourselves to RELOC
        movea.l #RELOC,a1
        move.l  #CODELEN,d0
.cp:    move.b  (a0)+,(a1)+
        subq.l  #1,d0
        bne     .cp
        movea.l #RELOC+(reloc_go-__start),a0
        jmp     (a0)            ; continue in the relocated copy
.bad:   moveq   #ERR_IPAR,d0
        rts

reloc_go:
        movea.l #DSTACK,sp
        movea.l d1,a2           ; a2 = window start
        movea.l d2,a3           ; a3 = window end
        move.l  d3,d7           ; d7 = flags
        movea.l #DRESULT,a4
        bsr     clr_result
        clr.l   40(a4)          ; panel not drawn yet
        move.l  #SCREEN,36(a4)  ; enable the progress overlay
        move.l  #1,76(a4)       ; red border: destructive mode
        movea.l #SCREEN,a0      ; clear the screen
        move.w  #8191,d0
.cs:    clr.l   (a0)+
        dbra    d0,.cs
        movea.l #SCREEN+1024+34,a5 ; double-size title, centred, row 1
        lea     s_title(pc),a0
        bsr     puts_big
        moveq   #4,d0           ; window line, centred (28 chars)
        bsr     scr_at
        lea     32(a5),a5
        lea     s_window(pc),a0
        bsr     puts
        moveq   #'$',d0
        bsr     putc
        move.l  a2,d0
        bsr     puthexl
        lea     s_dash(pc),a0
        bsr     puts
        moveq   #'$',d0
        bsr     putc
        move.l  a3,d0
        bsr     puthexl
        moveq   #0,d6           ; pass count (0 -> 1)
        move.b  d7,d6
        bne     .pok
        moveq   #1,d6
.pok:   move.l  d6,64(a4)       ; pass target for the panel
.ploop: bsr     suite_scr
        addq.l  #1,20(a4)
        subq.w  #1,d6
        bne     .ploop
        tst.l   (a4)            ; verdict from the fail bitmap
        bne     .failed
        moveq   #21,d0          ; green banner
        moveq   #0,d1
        bsr     fill_band
        movea.l #SCREEN+21*1024+50,a5
        lea     s_allpass(pc),a0
        moveq   #0,d1
        bsr     puts_band
        bra     .halt
.failed:
        moveq   #20,d0
        bsr     scr_at
        lea     30(a5),a5       ; centre the 30-char detail line
        lea     s_failat(pc),a0
        bsr     puts
        move.l  4(a4),d0
        bsr     puthexl
        lea     s_exp(pc),a0
        bsr     puts
        move.l  8(a4),d0
        bsr     puthexb
        lea     s_act(pc),a0
        bsr     puts
        move.l  12(a4),d0
        bsr     puthexb
        moveq   #21,d0          ; red banner
        moveq   #1,d1
        bsr     fill_band
        movea.l #SCREEN+21*1024+52,a5
        lea     s_failed(pc),a0
        moveq   #1,d1
        bsr     puts_band
.halt:  move.l  #1,32(a4)
        moveq   #1,d0           ; overlay: TESTS FINISHED (no enter wait)
        bsr     prog_done
        moveq   #22,d0
        bsr     scr_at
        lea     44(a5),a5       ; centre the 15-char done line
        lea     s_done(pc),a0
        bsr     puts
.stop:  bsr     .bdly           ; blink 'TESTS FINISHED' for as long as
        moveq   #3,d0           ; the QL sits here, roughly 1s per cycle
        bsr     pline
        bsr     .bdly
        bsr     fin_line
        bra     .stop
.bdly:  movem.l d0-d1,-(sp)     ; about half a second; there are no
        moveq   #2,d0           ; interrupts left to time it with
.bo:    move.w  #$FFFF,d1
.bi:    dbra    d1,.bi
        dbra    d0,.bo
        movem.l (sp)+,d0-d1
        rts

; run_suite with on-screen progress. All five tests share one line:
;   DATA BUS [x]  ADDR BUS [x]  ALIAS [x]  MARCH C- [x]  PATTERN [x]
; The bracket holds a spinner while the test runs, then a green tick if
; every pass so far has passed or a red X once any pass has failed. The
; line is wiped and redrawn blank at the start of each pass.
suite_scr:
        movem.l d4-d6/a0-a1,-(sp)
        bsr     list_draw
        moveq   #1,d4
        lea     ttab(pc),a1
.next:  move.w  (a1)+,d5
        beq     .fin
        move.l  d4,28(a4)
        bsr     spin_tick       ; first frame, so no slot sits blank
        lea     ttab(pc),a0
        adda.w  d5,a0
        movem.l d4-d5/a1,-(sp)
        jsr     (a0)
        movem.l (sp)+,d4-d5/a1
        tst.l   d0
        beq     .st
        bsr     record_fail
        move.w  d4,d5           ; per-test fail counter++
        subq.w  #1,d5
        lsl.w   #2,d5
        lea     44(a4),a0
        addq.l  #1,0(a0,d5.w)
.st:    moveq   #1,d0           ; bar to test/5 exactly
        moveq   #1,d1
        bsr     prog_frac       ; the spinner's last frame lands here
        move.w  d4,d5           ; verdict from the cumulative counter
        subq.w  #1,d5
        lsl.w   #2,d5
        move.l  44(a4,d5.w),d5
        move.w  d4,d0
        bsr     slot_at
        moveq   #CHK,d0
        moveq   #0,d1           ; green
        tst.l   d5
        beq     .put
        moveq   #'X',d0
        moveq   #1,d1           ; red
.put:   bsr     putcc
        addq.w  #1,d4
        bra     .next
.fin:   moveq   #0,d0
        tst.l   (a4)
        beq     .out
        moveq   #1,d0
.out:   movem.l (sp)+,d4-d6/a0-a1
        rts

; d3.w = test index 0-4; returns a0 = its name and d2.w = the length.
name_at:
        movem.l d1,-(sp)
        lea     ntab(pc),a0
        move.w  d3,d1
        add.w   d1,d1
        move.w  0(a0,d1.w),d1
        adda.w  d1,a0
        moveq   #-1,d2
.l:     addq.w  #1,d2
        tst.b   0(a0,d2.w)
        bne     .l
        movem.l (sp)+,d1
        rts

; d0.w = test number 1-5; returns a5 = the screen address of that test's
; status cell. Walks the names because the slots are unequal widths.
slot_at:
        movem.l d0-d3/a0,-(sp)
        movea.l #LISTBASE,a5
        moveq   #0,d3
.l:     bsr     name_at
        add.w   d2,d2           ; character cells are two bytes wide
        addq.w  #1,d3
        cmp.w   d0,d3
        beq     .here
        adda.w  d2,a5
        lea     10(a5),a5       ; ' [x] ' sits between two names
        cmpi.w  #5,d3
        blo     .l
.here:  adda.w  d2,a5
        lea     4(a5),a5        ; step over the space and the '['
        movem.l (sp)+,d0-d3/a0
        rts

; wipe the status line and redraw every name with an empty bracket
list_draw:
        movem.l d0-d3/a0/a5,-(sp)
        movea.l #SCREEN+LISTROW*1024,a0
        move.w  #255,d0         ; one text row = 8 pixel rows of 128
.cl:    clr.l   (a0)+
        dbra    d0,.cl
        movea.l #LISTBASE,a5
        moveq   #0,d3
.l:     bsr     name_at
        bsr     puts
        lea     s_slot(pc),a0
        bsr     puts
        addq.w  #1,d3
        cmpi.w  #5,d3
        blo     .l
        movem.l (sp)+,d0-d3/a0/a5
        rts

; advance the spinner one frame in the running test's slot. Destructive
; mode only: 76(a4) is what tells the two modes apart, and the safe-mode
; overlay has no test list to draw into.
spin_tick:
        tst.l   76(a4)
        beq     .out
        movem.l d0-d2/a0/a5,-(sp)
        move.l  28(a4),d0
        beq     .done
        cmpi.l  #5,d0
        bhi     .done
        lea     spin_ix(pc),a0
        moveq   #0,d1
        move.b  (a0),d1
        addq.b  #1,d1
        andi.w  #3,d1
        move.b  d1,(a0)
        lea     spin_ch(pc),a0
        move.b  0(a0,d1.w),d2
        bsr     slot_at
        move.b  d2,d0
        moveq   #2,d1           ; white
        bsr     putcc
.done:  movem.l (sp)+,d0-d2/a0/a5
.out:   rts

; Slice a long linear sweep so the spinner keeps moving through it: a1
; becomes the end of the next CHUNK bytes, clamped to the window.
chk_up:                         ; ascending: a1 = min(a0+CHUNK, a3)
        movea.l a0,a1
        adda.l  #CHUNK,a1
        cmpa.l  a3,a1
        bls     .ok
        movea.l a3,a1
.ok:    bra     spin_tick       ; tail call
chk_dn:                         ; descending: a1 = max(a0-CHUNK, a2)
        movea.l a0,a1
        suba.l  #CHUNK,a1
        cmpa.l  a2,a1
        bhs     .ok
        movea.l a2,a1
.ok:    bra     spin_tick       ; tail call

; ---------------------------------------------------------------------
; Test 1: data bus - walking 1s and 0s at one location per 64K block.
; All tests: in a2=start a3=end; out d0=0 pass, d0=1 fail with
; d1=address d2=expected d3=actual. Preserve a2-a4/d7.
; ---------------------------------------------------------------------
t_databus:
        movem.l d4-d6/a0,-(sp)
        movea.l a2,a0
.blk:   bsr     prog_addr
        moveq   #0,d4           ; walking 1
.w1:    moveq   #1,d5
        lsl.b   d4,d5
        move.b  d5,(a0)
        move.b  (a0),d6
        cmp.b   d5,d6
        bne     .fail
        addq.w  #1,d4
        cmpi.w  #8,d4
        blo     .w1
        moveq   #0,d4           ; walking 0
.w0:    moveq   #1,d5
        lsl.b   d4,d5
        not.b   d5
        move.b  d5,(a0)
        move.b  (a0),d6
        cmp.b   d5,d6
        bne     .fail
        addq.w  #1,d4
        cmpi.w  #8,d4
        blo     .w0
        adda.l  #$10000,a0
        cmpa.l  a3,a0
        blo     .blk
        moveq   #0,d0
        movem.l (sp)+,d4-d6/a0
        rts
.fail:  move.l  a0,d1
        moveq   #0,d2
        move.b  d5,d2
        moveq   #0,d3
        move.b  d6,d3
        moveq   #1,d0
        movem.l (sp)+,d4-d6/a0
        rts

; ---------------------------------------------------------------------
; Test 2: address bus - power-of-2 offset probes (Barr's algorithm).
; ---------------------------------------------------------------------
t_addrbus:
        movem.l d4-d6/a0-a1,-(sp)
        move.l  a3,d4
        sub.l   a2,d4           ; d4 = window length
        cmpi.l  #2,d4
        blo     .skip
        move.b  #$AA,(a2)       ; fill base + power-of-2 offsets
        moveq   #1,d5
.f:     cmp.l   d4,d5
        bhs     .fdone
        movea.l a2,a0
        adda.l  d5,a0
        move.b  #$AA,(a0)
        add.l   d5,d5
        bra     .f
.fdone: move.b  #$55,(a2)       ; stuck-high check
        moveq   #1,d5
.s:     cmp.l   d4,d5
        bhs     .sdone
        movea.l a2,a0
        adda.l  d5,a0
        move.b  (a0),d6
        cmpi.b  #$AA,d6
        bne     .fail
        add.l   d5,d5
        bra     .s
.sdone: move.b  #$AA,(a2)
        moveq   #1,d5           ; shorted-lines check
.t:     cmp.l   d4,d5
        bhs     .ok
        movea.l a2,a0
        adda.l  d5,a0
        bsr     prog_addr
        move.b  #$55,(a0)
        move.b  (a2),d6
        cmpi.b  #$AA,d6
        bne     .failb
        moveq   #1,d6
.ti:    cmp.l   d4,d6
        bhs     .tnext
        cmp.l   d5,d6
        beq     .tskip
        movea.l a2,a1
        adda.l  d6,a1
        move.b  (a1),d0
        cmpi.b  #$AA,d0
        bne     .failo
.tskip: add.l   d6,d6
        bra     .ti
.tnext: movea.l a2,a0
        adda.l  d5,a0
        move.b  #$AA,(a0)
        add.l   d5,d5
        bra     .t
.ok:
.skip:  moveq   #0,d0
        movem.l (sp)+,d4-d6/a0-a1
        rts
.fail:  move.l  a0,d1
        moveq   #0,d3
        move.b  d6,d3
        bra     .rep
.failb: move.l  a2,d1
        moveq   #0,d3
        move.b  d6,d3
        bra     .rep
.failo: move.l  a1,d1
        moveq   #0,d3
        move.b  d0,d3
.rep:   move.l  #$AA,d2
        moveq   #1,d0
        movem.l (sp)+,d4-d6/a0-a1
        rts

; ---------------------------------------------------------------------
; Test 3: aliasing - unique tag at the start of every 4K page, then
; verify. A GAL decode fault or stacked-card overlap maps two pages
; onto the same RAM, so the later tag overwrites the earlier one.
; ---------------------------------------------------------------------
t_alias:
        movem.l d4-d6/a0,-(sp)
        move.l  a3,d4
        sub.l   a2,d4
        cmpi.l  #$2000,d4       ; need at least two pages
        blo     .skip
        movea.l a2,a0           ; pass 1: tag = page index
        moveq   #0,d5
.w1:    bsr     prog_addr
        move.b  d5,(a0)
        addq.b  #1,d5
        adda.l  #$1000,a0
        cmpa.l  a3,a0
        blo     .w1
        movea.l a2,a0
        moveq   #0,d5
.v1:    bsr     prog_addr
        move.b  (a0),d6
        cmp.b   d5,d6
        bne     .fail
        addq.b  #1,d5
        adda.l  #$1000,a0
        cmpa.l  a3,a0
        blo     .v1
        movea.l a2,a0           ; pass 2: tag = ~page index
        moveq   #0,d5
.w2:    bsr     prog_addr
        move.b  d5,d6
        not.b   d6
        move.b  d6,(a0)
        addq.b  #1,d5
        adda.l  #$1000,a0
        cmpa.l  a3,a0
        blo     .w2
        movea.l a2,a0
        moveq   #0,d5
.v2:    bsr     prog_addr
        move.b  d5,d6
        not.b   d6
        move.b  (a0),d0
        cmp.b   d6,d0
        bne     .fail2
        addq.b  #1,d5
        adda.l  #$1000,a0
        cmpa.l  a3,a0
        blo     .v2
.skip:  moveq   #0,d0
        movem.l (sp)+,d4-d6/a0
        rts
.fail:  move.l  a0,d1
        moveq   #0,d2
        move.b  d5,d2
        moveq   #0,d3
        move.b  d6,d3
        moveq   #1,d0
        movem.l (sp)+,d4-d6/a0
        rts
.fail2: move.l  a0,d1
        moveq   #0,d2
        move.b  d6,d2
        moveq   #0,d3
        move.b  d0,d3
        moveq   #1,d0
        movem.l (sp)+,d4-d6/a0
        rts

; ---------------------------------------------------------------------
; Test 4: March C-  (w0; r0,w1; r1,w0 ascending; r0,w1; r1,w0; r0
; descending) - stuck-at, transition and coupling faults.
; ---------------------------------------------------------------------
t_marchc:
        movem.l d6/a0-a1,-(sp)
        moveq   #0,d0
        bsr     .pr6
        movea.l a2,a0           ; up: w0
.s1:    bsr     chk_up
.e1:    clr.b   (a0)+
        cmpa.l  a1,a0
        blo     .e1
        cmpa.l  a3,a0
        blo     .s1
        moveq   #1,d0
        bsr     .pr6
        movea.l a2,a0           ; up: r0,w1
.s2:    bsr     chk_up
.e2:    move.b  (a0),d6
        bne     .fail0
        move.b  #$FF,(a0)+
        cmpa.l  a1,a0
        blo     .e2
        cmpa.l  a3,a0
        blo     .s2
        moveq   #2,d0
        bsr     .pr6
        movea.l a2,a0           ; up: r1,w0
.s3:    bsr     chk_up
.e3:    move.b  (a0),d6
        cmpi.b  #$FF,d6
        bne     .fail1
        clr.b   (a0)+
        cmpa.l  a1,a0
        blo     .e3
        cmpa.l  a3,a0
        blo     .s3
        moveq   #3,d0
        bsr     .pr6
        movea.l a3,a0           ; down: r0,w1
.s4:    bsr     chk_dn
.e4:    move.b  -(a0),d6
        bne     .fail0
        move.b  #$FF,(a0)
        cmpa.l  a1,a0
        bhi     .e4
        cmpa.l  a2,a0
        bhi     .s4
        moveq   #4,d0
        bsr     .pr6
        movea.l a3,a0           ; down: r1,w0
.s5:    bsr     chk_dn
.e5:    move.b  -(a0),d6
        cmpi.b  #$FF,d6
        bne     .fail1
        clr.b   (a0)
        cmpa.l  a1,a0
        bhi     .e5
        cmpa.l  a2,a0
        bhi     .s5
        moveq   #5,d0
        bsr     .pr6
        movea.l a3,a0           ; down: r0
.s6:    bsr     chk_dn
.e6:    move.b  -(a0),d6
        bne     .fail0
        cmpa.l  a1,a0
        bhi     .e6
        cmpa.l  a2,a0
        bhi     .s6
        moveq   #6,d0
        bsr     .pr6
        moveq   #0,d0
        movem.l (sp)+,d6/a0-a1
        rts
.pr6:   moveq   #6,d1
        bra     prog_frac       ; tail call
.fail0: moveq   #0,d2
        bra     .fx
.fail1: move.l  #$FF,d2
.fx:    move.l  a0,d1
        moveq   #0,d3
        move.b  d6,d3
        moveq   #1,d0
        movem.l (sp)+,d6/a0-a1
        rts

; ---------------------------------------------------------------------
; Test 5: checkerboard $55/$AA, ~2s retention delay, verify; then the
; inverted pattern. Flag bit 8 skips the delays (emulator runs).
; ---------------------------------------------------------------------
t_checker:
        movem.l d4-d6/a0-a1,-(sp)
        moveq   #0,d4           ; phase 0: $55 first, phase 1: $AA first
.phase: move.b  #$55,d5
        tst.w   d4
        beq     .fill
        move.b  #$AA,d5
.fill:  moveq   #0,d0
        move.w  d4,d0
        add.l   d0,d0
        moveq   #4,d1
        bsr     prog_frac
        movea.l a2,a0
        move.b  d5,d6
.fc:    bsr     chk_up
.f1:    move.b  d6,(a0)+
        not.b   d6
        cmpa.l  a1,a0
        blo     .f1
        cmpa.l  a3,a0
        blo     .fc
        bsr     delay2s
        moveq   #0,d0
        move.w  d4,d0
        add.l   d0,d0
        addq.l  #1,d0
        moveq   #4,d1
        bsr     prog_frac
        movea.l a2,a0
        move.b  d5,d6
.vc:    bsr     chk_up
.v1:    move.b  (a0),d0
        cmp.b   d6,d0
        bne     .fail
        addq.l  #1,a0
        not.b   d6
        cmpa.l  a1,a0
        blo     .v1
        cmpa.l  a3,a0
        blo     .vc
        addq.w  #1,d4
        cmpi.w  #2,d4
        blo     .phase
        moveq   #1,d0
        moveq   #1,d1
        bsr     prog_frac
        moveq   #0,d0
        movem.l (sp)+,d4-d6/a0-a1
        rts
.fail:  move.l  a0,d1
        moveq   #0,d2
        move.b  d6,d2
        moveq   #0,d3
        move.b  d0,d3
        moveq   #1,d0
        movem.l (sp)+,d4-d6/a0-a1
        rts

; ~2 seconds busy loop on a 7.5MHz 68008; skipped when flag bit 8 set
delay2s:
        btst    #8,d7
        bne     .skip
        movem.l d0-d1,-(sp)
        moveq   #11,d0
.o:     bsr     spin_tick       ; the retention wait still looks alive
        move.w  #$FFFF,d1
.i:     dbra    d1,.i
        dbra    d0,.o
        movem.l (sp)+,d0-d1
.skip:  rts

; ---------------------------------------------------------------------
; Minimal MODE 4 screen output (destructive mode only).
; a5 = cursor (screen address of next character cell).
; ---------------------------------------------------------------------
scr_at:                         ; d0.w = text row 0-31
        movem.l d0,-(sp)
        andi.l  #31,d0
        lsl.l   #8,d0
        lsl.l   #2,d0           ; row * 1024 (8 lines of 128 bytes)
        addi.l  #SCREEN+4,d0    ; two-character left margin
        movea.l d0,a5
        movem.l (sp)+,d0
        rts

puts:                           ; a0 = zero-terminated string
        movem.l d0/a0,-(sp)
.l:     move.b  (a0)+,d0
        beq     .e
        bsr     putc
        bra     .l
.e:     movem.l (sp)+,d0/a0
        rts

glyphof:                        ; d0.b char -> a0 = glyph bitmap
        movem.l d1-d2,-(sp)
        lea     charmap(pc),a0
        moveq   #0,d1
.f:     move.b  (a0)+,d2
        beq     .nf
        cmp.b   d0,d2
        beq     .got
        addq.w  #1,d1
        bra     .f
.nf:    moveq   #0,d1           ; unknown -> space (index 0)
.got:   lea     glyphs(pc),a0
        lsl.w   #3,d1
        adda.w  d1,a0
        movem.l (sp)+,d1-d2
        rts

putc:                           ; d0.b = character (see charmap)
        movem.l d0-d2/a0-a1,-(sp)
        bsr     glyphof
        movea.l a5,a1
        moveq   #7,d2
.dr:    move.b  (a0),(a1)       ; green plane
        move.b  (a0)+,1(a1)     ; red plane -> white pixels
        lea     128(a1),a1
        dbra    d2,.dr
        addq.l  #2,a5
        movem.l (sp)+,d0-d2/a0-a1
        rts

putcc:                          ; d0.b = char, d1 = 0 green 1 red 2 white
        movem.l d0-d3/a0-a1,-(sp)
        bsr     glyphof
        movea.l a5,a1
        moveq   #7,d2
.dr:    move.b  (a0)+,d3
        clr.b   (a1)            ; both planes: the cell is redrawn often
        clr.b   1(a1)
        cmpi.w  #1,d1
        beq     .red
        move.b  d3,(a1)         ; green plane
        cmpi.w  #2,d1
        bne     .nx
.red:   move.b  d3,1(a1)        ; red plane; both planes together = white
.nx:    lea     128(a1),a1
        dbra    d2,.dr
        addq.l  #2,a5
        movem.l (sp)+,d0-d3/a0-a1
        rts

; double-size (16x16) text: each glyph pixel becomes 2x2
puts_big:                       ; a0 = string, a5 = cursor
        movem.l d0/a0,-(sp)
.l:     move.b  (a0)+,d0
        beq     .e
        bsr     putbig
        bra     .l
.e:     movem.l (sp)+,d0/a0
        rts

putbig:                         ; d0.b = character; cursor advances 4
        movem.l d1-d5/a0-a1,-(sp)
        bsr     glyphof
        move.l  (a0)+,d4        ; glyph rows 0-3
        move.l  (a0),d5         ; glyph rows 4-7
        lea     dbltab(pc),a0
        movea.l a5,a1
        moveq   #3,d2
.l1:    rol.l   #8,d4
        move.w  d4,d3
        bsr     .row
        dbra    d2,.l1
        moveq   #3,d2
.l2:    rol.l   #8,d5
        move.w  d5,d3
        bsr     .row
        dbra    d2,.l2
        addq.l  #4,a5
        movem.l (sp)+,d1-d5/a0-a1
        rts
.row:   move.w  d3,d1           ; expand one glyph row to 16px, draw twice
        lsr.w   #4,d1
        andi.w  #$0F,d1
        move.b  0(a0,d1.w),d1
        andi.w  #$0F,d3
        move.b  0(a0,d3.w),d3
        move.b  d1,(a1)
        move.b  d1,1(a1)
        move.b  d3,2(a1)
        move.b  d3,3(a1)
        lea     128(a1),a1
        move.b  d1,(a1)
        move.b  d1,1(a1)
        move.b  d3,2(a1)
        move.b  d3,3(a1)
        lea     128(a1),a1
        rts

puthexl:                        ; d0.l as 8 hex digits
        movem.l d0-d2,-(sp)
        moveq   #7,d2
.n:     rol.l   #4,d0
        move.b  d0,d1
        andi.b  #$0F,d1
        cmpi.b  #10,d1
        blo     .dig
        addi.b  #'A'-10,d1
        bra     .p
.dig:   addi.b  #'0',d1
.p:     move.l  d0,-(sp)
        move.b  d1,d0
        bsr     putc
        move.l  (sp)+,d0
        dbra    d2,.n
        movem.l (sp)+,d0-d2
        rts

puthexb:                        ; d0.b as 2 hex digits
        movem.l d0-d2,-(sp)
        move.b  d0,d2
        lsr.b   #4,d0
        bsr     .nib
        move.b  d2,d0
        bsr     .nib
        movem.l (sp)+,d0-d2
        rts
.nib:   andi.b  #$0F,d0
        cmpi.b  #10,d0
        blo     .d
        addi.b  #'A'-10,d0
        bra     .pp
.d:     addi.b  #'0',d0
.pp:    bra     putc            ; tail call

; ---------------------------------------------------------------------
; Progress overlay: a bordered panel centred on the screen showing
;    PASS n
;    TEST n <name>
;    [########..........]
; Enabled when 36(a4) holds any address inside the frame buffer (the
; value is only an enable; the panel position is fixed). 40(a4) is the
; internal "panel drawn" flag, reset at the start of every run.
; prog_frac: d0 = numerator, d1 = denominator of the current test's
; local progress; the current test (28(a4)) is folded in so the bar
; sweeps once per pass. All registers preserved.
; ---------------------------------------------------------------------
PROW    equ     13                      ; panel top text row (of 7)
PBASE   equ     SCREEN+PROW*1024
PXOFF   equ     16                      ; panel left edge (bytes)

prog_frac:
        movem.l d0-d5/a0-a1/a5,-(sp)
        move.l  36(a4),d2
        cmpi.l  #SCREEN,d2
        blo     .out
        cmpi.l  #SCREEN+$7C00,d2
        bhi     .out
        bsr     spin_tick
        tst.l   d1
        beq     .out
        cmp.l   d1,d0           ; clamp numerator
        bls     .cl
        move.l  d1,d0
.cl:    move.l  28(a4),d3       ; one bar per pass: fold in test number,
        subq.l  #1,d3           ; overall = (test-1 + local)/5
        bpl     .t0
        moveq   #0,d3
.t0:    cmpi.l  #4,d3
        bls     .t1
        moveq   #4,d3
.t1:    mulu    d1,d3
        add.l   d3,d0
        move.l  d1,d3
        lsl.l   #2,d1
        add.l   d3,d1
        move.l  d0,d3           ; filled pairs = 40*num/den
        lsl.l   #5,d0
        lsl.l   #3,d3
        add.l   d3,d0
        divu    d1,d0
        moveq   #0,d5
        move.w  d0,d5           ; d5 = filled pairs (0..40)
        bsr     pinit
        ; --- text lines: redraw only when the pass/test state changes ---
        move.l  20(a4),d3
        addq.l  #1,d3
        lsl.l   #8,d3
        or.l    28(a4),d3       ; state = (pass)<<8 | test
        cmp.l   72(a4),d3
        beq     .lines_ok
        move.l  d3,72(a4)
        ; PASS line (panel row 1): 'PASS nn/NN' at fixed centre
        movea.l #PBASE+1024+PXOFF+38,a5
        lea     s_pass2(pc),a0
        bsr     puts
        move.l  20(a4),d0
        addq.l  #1,d0
        bsr     put2dec
        moveq   #'/',d0
        bsr     putc
        move.l  64(a4),d0
        bsr     put2dec
        ; TEST line (panel row 2): 'TEST n <name>' centred
        moveq   #2,d0
        bsr     pline
        move.l  28(a4),d3
        subq.l  #1,d3
        bpl     .u0
        moveq   #0,d3
.u0:    cmpi.l  #4,d3
        bls     .u1
        moveq   #4,d3
.u1:    bsr     name_at         ; a0 = test name, d2 = its length
        moveq   #82,d0          ; xoff = PXOFF + (96-14-2*len)/2, even
        sub.w   d2,d0
        sub.w   d2,d0
        lsr.w   #1,d0
        andi.w  #$FFFE,d0
        addi.w  #PXOFF,d0
        movea.l #PBASE+2048,a5
        adda.w  d0,a5
        move.l  a0,-(sp)
        lea     s_test(pc),a0
        bsr     puts
        move.l  (sp)+,a0
        moveq   #'1',d0
        add.w   d3,d0
        bsr     putc
        moveq   #' ',d0
        bsr     putc
        bsr     puts            ; name
.lines_ok:
        ; --- bar (panel row 4): green fill, delta-drawn ---
        move.l  68(a4),d4       ; last drawn fill
        cmp.l   d5,d4
        beq     .out
        move.l  d5,68(a4)
        cmp.l   d5,d4
        bls     .grow
        moveq   #0,d4           ; fill went down (new pass): redraw all
.grow:  movea.l #PBASE+4096+PXOFF+8,a0
        adda.w  d4,a0
        adda.w  d4,a0           ; a0 = first cell to draw
.cell:  cmp.w   d5,d4
        bhs     .bdone
        movea.l a0,a1
        lea     128(a1),a1      ; pixel rows 1-6 of the cell
        moveq   #5,d0
.rw:    move.b  #$FF,(a1)       ; green plane on, red plane off
        clr.b   1(a1)
        lea     128(a1),a1
        dbra    d0,.rw
        addq.l  #2,a0
        addq.w  #1,d4
        bra     .cell
.bdone: ; clear any cells beyond the fill (pass reset)
        cmp.w   #40,d4
        bhs     .out
        movea.l a0,a1
        lea     128(a1),a1
        moveq   #5,d0
.cw:    clr.b   (a1)
        clr.b   1(a1)
        lea     128(a1),a1
        dbra    d0,.cw
        addq.l  #2,a0
        addq.w  #1,d4
        bra     .bdone
.out:   movem.l (sp)+,d0-d5/a0-a1/a5
        rts

; print d0 (0-99) as two decimal digits, blank leading zero
put2dec:
        movem.l d0-d2,-(sp)
        cmpi.l  #99,d0
        bls     .ok
        moveq   #99,d0
.ok:    divu    #10,d0
        move.l  d0,d2
        swap    d2              ; d2.w = units
        move.w  d0,d1           ; d1.w = tens
        moveq   #' ',d0
        tst.w   d1
        beq     .pt
        moveq   #'0',d0
        add.w   d1,d0
.pt:    bsr     putc
        moveq   #'0',d0
        add.w   d2,d0
        bsr     putc
        movem.l (sp)+,d0-d2
        rts

; final overlay state: 'TESTS FINISHED' (+ 'PRESS ENTER' unless d0=1)
prog_done:
        movem.l d0-d5/a0-a1/a5,-(sp)
        move.l  d0,d5
        move.l  36(a4),d2
        cmpi.l  #SCREEN,d2
        blo     .out
        cmpi.l  #SCREEN+$7C00,d2
        bhi     .out
        bsr     pinit
        moveq   #2,d0
        bsr     pline           ; wipe the TEST n line
        moveq   #3,d0
        bsr     pline
        bsr     fin_line
        moveq   #4,d0
        bsr     pline           ; wipe the bar row
        tst.l   d5
        bne     .out
        movea.l #PBASE+4096+PXOFF+36,a5 ; 'PRESS ENTER' centred
        lea     s_enter(pc),a0
        bsr     puts
.out:   movem.l (sp)+,d0-d5/a0-a1/a5
        rts

; 'TESTS FINISHED' centred on panel row 3. Split out because the
; destructive halt loop blinks it by alternating this with pline.
fin_line:
        movem.l d0/a0/a5,-(sp)
        movea.l #PBASE+3072+PXOFF+34,a5
        lea     s_fin(pc),a0
        bsr     puts
        movem.l (sp)+,d0/a0/a5
        rts

; draw panel background + border once per run (40(a4) = drawn flag);
; border is white for safe modes, red when 76(a4) is set (destructive)
pinit:
        movem.l d0-d2/a0-a1/a5,-(sp)
        tst.l   40(a4)
        bne     .out
        move.l  #1,40(a4)
        clr.l   68(a4)          ; bar starts empty
        moveq   #-1,d0
        move.l  d0,72(a4)       ; force first text draw
        moveq   #-1,d2          ; border pattern: white
        tst.l   76(a4)
        beq     .cw
        move.w  #$00FF,d2       ; red plane only
.cw:    movea.l #PBASE,a0       ; clear 56 pixel rows x 96 bytes
        moveq   #55,d1
.r:     movea.l a0,a1
        adda.w  #PXOFF,a1
        moveq   #23,d0
.c:     clr.l   (a1)+
        dbra    d0,.c
        lea     128(a0),a0
        dbra    d1,.r
        movea.l #PBASE+PXOFF,a0 ; top border, 2 pixel rows
        bsr     .hline2
        movea.l #PBASE+54*128+PXOFF,a0 ; bottom border
        bsr     .hline2
        movea.l #PBASE+PXOFF,a0 ; vertical edges
        moveq   #55,d1
.v:     move.w  d2,(a0)
        move.w  d2,94(a0)
        lea     128(a0),a0
        dbra    d1,.v
        movea.l #PBASE+4096+PXOFF+6,a5 ; static bar brackets
        moveq   #'[',d0
        bsr     putc
        lea     80(a5),a5
        moveq   #']',d0
        bsr     putc
.out:   movem.l (sp)+,d0-d2/a0-a1/a5
        rts
.hline2:
        movem.l d0/a0-a1,-(sp)
        movea.l a0,a1
        moveq   #47,d0
.h1:    move.w  d2,(a1)+
        dbra    d0,.h1
        movea.l a0,a1
        lea     128(a1),a1
        moveq   #47,d0
.h2:    move.w  d2,(a1)+
        dbra    d0,.h2
        movem.l (sp)+,d0/a0-a1
        rts

; full-width colored band, 8 pixel rows at text row d0; d1 = 0 green/1 red
fill_band:
        movem.l d0-d2/a0,-(sp)
        lsl.l   #8,d0
        lsl.l   #2,d0
        addi.l  #SCREEN,d0
        movea.l d0,a0
        move.w  #$FF00,d2       ; green
        tst.l   d1
        
        beq     .go
        move.w  #$00FF,d2       ; red
.go:    move.w  #511,d0         ; 8 rows x 64 words
.f:     move.w  d2,(a0)+
        dbra    d0,.f
        movem.l (sp)+,d0-d2/a0
        rts

; white text on a colored band at cursor a5; d1 = 0 green/1 red
puts_band:
        movem.l d0/a0,-(sp)
.l:     move.b  (a0)+,d0
        beq     .e
        bsr     putcb
        bra     .l
.e:     movem.l (sp)+,d0/a0
        rts

putcb:
        movem.l d0-d3/a0-a1,-(sp)
        bsr     glyphof
        movea.l a5,a1
        moveq   #7,d2
.dr:    move.b  (a0)+,d3
        tst.l   d1
        bne     .red
        move.b  #$FF,(a1)       ; band green + glyph red = white text
        move.b  d3,1(a1)
        bra     .nx
.red:   move.b  d3,(a1)         ; glyph green + band red = white text
        move.b  #$FF,1(a1)
.nx:    lea     128(a1),a1
        dbra    d2,.dr
        addq.l  #2,a5
        movem.l (sp)+,d0-d3/a0-a1
        rts

; clear the interior of panel text row d0 (0-6)
pline:
        movem.l d0-d1/a0-a1,-(sp)
        lsl.l   #8,d0
        lsl.l   #2,d0
        addi.l  #PBASE+PXOFF+4,d0
        movea.l d0,a0
        moveq   #7,d1
.r:     movea.l a0,a1
        moveq   #21,d0          ; 88 bytes = 22 longs
.c:     clr.l   (a1)+
        dbra    d0,.c
        lea     128(a0),a0
        dbra    d1,.r
        movem.l (sp)+,d0-d1/a0-a1
        rts

; progress from a position: fraction = (a0-a2) / (a3-a2), in 4K units
prog_addr:
        movem.l d0-d2,-(sp)
        move.l  a0,d0
        sub.l   a2,d0
        move.l  a3,d1
        sub.l   a2,d1
        moveq   #12,d2
        lsr.l   d2,d0
        lsr.l   d2,d1
        bne     .ok
        moveq   #1,d1           ; window < 4K: avoid divide by zero
.ok:    bsr     prog_frac
        movem.l (sp)+,d0-d2
        rts

