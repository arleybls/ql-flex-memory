1670 DEFine PROCedure show_results
1672   LOCal bm, t, i, cnt, xr, b, d$, ex, rd
1690   bm = PEEK_L(rb)
1700   PRINT
1710   IF bm = 0
1712     INK #1,4 : CSIZE #1,2,1
1714     PRINT "ALL TESTS PASSED"
1716     CSIZE #1,0,0 : INK #1,7
1718     BEEP 3000,20
1720   ELSE
1722     INK #1,2 : CSIZE #1,2,1
1724     PRINT "FAULTS FOUND"
1726     CSIZE #1,0,0 : INK #1,7
1728     BEEP 30000,200
1730   END IF
1740   PRINT "Passes: "; PEEK_L(rb+20); " of "; PEEK_L(rb+64); "   Bytes: "; PEEK_L(rb+24)
1742   PRINT
1744   FOR i = 1 TO 5
1746     cnt = PEEK_L(rb+40+4*i)
1748     PRINT " "; i; " "; tname$(i); " : ";
1750     IF cnt = 0
1752       INK #1,4 : PRINT "OK" : INK #1,7
1754     ELSE
1756       INK #1,2 : PRINT "FAIL x"; cnt : INK #1,7
1758     END IF
1760   END FOR i
1762   IF bm = 0 THEN RETurn
1764   t = PEEK_L(rb+16)
1766   ex = PEEK_L(rb+8) : rd = PEEK_L(rb+12)
1768   PRINT
1770   PRINT "First fault: test "; t; " at $"; hx$(PEEK_L(rb+4),8)
1772   PRINT "  expected $"; hx$(ex,2); "  read $"; hx$(rd,2)
1774   IF t = 2 OR t = 3
1776     PRINT "Address decode fault - check GAL,"
1778     PRINT "jumpers and address lines."
1780     RETurn
1782   END IF
1784   xr = ex ^^ rd
1786   d$ = ""
1788   FOR b = 0 TO 7
1790     IF xr && (2^b) THEN d$ = d$ & " D" & b
1792   END FOR b
1794   IF LEN(d$) = 0 THEN RETurn
1796   PRINT "Data line(s):"; d$;
1798   IF xr && ex THEN PRINT " (stuck/dropping LOW)" : ELSE PRINT " (stuck HIGH)"
1800   PRINT "Check the SRAM solder joints on those pins."
1820 END DEFine
