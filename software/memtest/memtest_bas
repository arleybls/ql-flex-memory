2290 REMark probe each device for memtest_bin with a tiny IO.OPEN helper
2300 DEFine PROCedure find_core
2310   LOCal i, w, d$, f$
2320   IF pb = 0
2330     pb = RESPR(128)
2340     RESTORE 2500
2350     FOR i = 0 TO 20 : READ w : POKE_W pb+2*i, w
2360   END IF
2370   RESTORE 2510
2380   REPeat dev_loop
2390     READ d$
2400     IF d$ = "*" THEN dev$ = "" : EXIT dev_loop
2410     f$ = d$ & "memtest_bin"
2420     POKE_W pb+64, LEN(f$)
2430     FOR i = 1 TO LEN(f$) : POKE pb+65+i, CODE(f$(i))
2440     CALL pb, pb+64, pb+120
2450     IF PEEK_L(pb+120) = 0 THEN dev$ = d$ : EXIT dev_loop
2460   END REPeat dev_loop
2470 END DEFine
