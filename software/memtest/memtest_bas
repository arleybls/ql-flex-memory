510 DEFine FuNction blk_ram(a)
520   LOCal s1, s2, ok
530   s1 = PEEK(a) : s2 = PEEK(a+16384)
540   POKE a,85 : POKE a+16384,170
550   ok = (PEEK(a) = 85) AND (PEEK(a+16384) = 170)
560   IF ok THEN POKE a,170 : POKE a+16384,85 : ok = (PEEK(a) = 170) AND (PEEK(a+16384) = 85)
570   POKE a,s1 : POKE a+16384,s2
580   RETurn ok
590 END DEFine
