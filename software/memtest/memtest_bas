1220 DEFine PROCedure safe_test
1230   LOCal fr, fl
1240   load_core : IF base = 0 THEN RETurn
1250   IF sbuf = 0
1260     fr = PEEK_L(sysbase+28) - PEEK_L(sysbase+24) : REMark sv_respr - sv_trnfr
1270     stsize = fr - 32768
1280     IF stsize > 458752 THEN stsize = 458752
1290     IF stsize < 16384 THEN PRINT "Not enough free memory - reboot and retry." : RETurn
1300     stsize = 16384 * INT(stsize/16384)
1310     sbuf = RESPR(stsize)
1312     IF sbuf < PEEK_L(sysbase+24)
1314       PRINT "RESPR gave memory below the free area -"
1316       PRINT "allocations from earlier runs have used it up."
1318       PRINT "Reboot the QL (restart the emulator) and retry."
1319       sbuf = 0 : stsize = 0 : RETurn
1320     END IF
1322   END IF
1330   fl = ask_flags
1332   est = INT((fl && 255) * (stsize/524288) + 0.9)
1334   IF est < 1 THEN est = 1
1340   PRINT "Buffer $"; hx$(sbuf,8); " - $"; hx$(sbuf+stsize-1,8); " ("; stsize/1024; "K)"
1345   PRINT "Estimated: about "; est; " min at real QL speed"
1350   PRINT "Testing (the QL stays usable afterwards)..."
1355   bar_setup
1360   CALL base, 0, sbuf, sbuf+stsize, fl, rb
1365   bar_wait
1370   show_results
1380 END DEFine
1390 :
1400 DEFine PROCedure window_test
1410   LOCal fl, k$
1425   load_core : IF base = 0 THEN RETurn
1430   detect_win
1440   IF ws = 0 THEN PRINT "No RAM outside QDOS found - use test 1 or 3." : RETurn
1450   PRINT "Detected window: $"; hx$(ws,8); " - $"; hx$(we-1,8); win$(ws,we)
1452   IF win$(ws,we) = "" THEN PRINT "WARNING: no known config matches - this may be a phantom window (floating bus) or a decode fault."
1454   k$ = "" : INPUT "Test this window ? (y/n) "; k$
1456   IF NOT (k$ == "y") THEN RETurn
1460   fl = ask_flags
1462   est = INT((fl && 255) * ((we-ws)/524288) + 0.9)
1464   IF est < 1 THEN est = 1
1470   PRINT "Testing window $"; hx$(ws,8); " - $"; hx$(we-1,8); "..."
1472   PRINT "Estimated: about "; est; " min at real QL speed"
1475   bar_setup
1480   CALL base, 1, ws, we, fl, rb
1485   bar_wait
1490   show_results
1500 END DEFine
1510 :
1520 DEFine PROCedure destr_test
1530   LOCal fl, c$, dws, dwe, ramt
1550   load_core : IF base = 0 THEN RETurn
1552   IF sysbase <> 163840
1553     PRINT "Sysvars are not at $28000 (Minerva dual-screen"
1554     PRINT "mode, or not a real QL). The destructive test"
1555     PRINT "assumes the standard memory map - disabled."
1556     PRINT "Reboot with the second screen off to use it."
1557     RETurn
1558   END IF
1559   ramt = PEEK_L(sysbase+32)
1560   detect_win
1561   dws = 0 : dwe = 0
1562   IF ramt > 262144 THEN dws = 262144 : dwe = ramt
1563   IF ws > 0
1564     IF dwe = ws
1565       dwe = we
1566     ELSE
1567       IF dws = 0 THEN dws = ws : dwe = we : ELSE PRINT "Extra RAM at $"; hx$(ws,8); " not contiguous - use test 2 for it."
1568     END IF
1569   END IF
1570   IF dws = 0 THEN PRINT "No expansion RAM found to test." : RETurn
1571   PRINT "Window: $"; hx$(dws,8); " - $"; hx$(dwe-1,8); win$(dws,dwe)
1572   PRINT
1573   PRINT "DESTRUCTIVE TEST: the machine is taken over,"
1580   PRINT "everything in RAM is destroyed and output goes"
1590   PRINT "directly to the screen. When it says DONE you"
1600   PRINT "must reset the QL. Save your work first!"
1610   c$ = "" : INPUT "Type YES to run it ? "; c$
1620   IF c$ <> "YES" THEN PRINT "Aborted." : RETurn
1630   fl = ask_flags
1632   FOR f = 1 TO 4 : BORDER #1,4,2 : BEEP 1000,30 : PAUSE 8 : BORDER #1,0 : PAUSE 4 : END FOR f
1640   CALL base+4, dws, dwe, fl
1650 END DEFine
