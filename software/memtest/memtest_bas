2210 DEFine PROCedure bar_wait
2220   REMark overlay says PRESS ENTER; blink TESTS FINISHED via the
2225   REMark core's +20 entry while waiting, then wipe it everywhere
2230   LOCal k$, ph
2240   IF PEEK_L(rb+36) = 0 THEN RETurn
2245   ph = 1
2250   REPeat wait_enter
2252     k$ = INKEY$(#1,25)
2254     IF k$ = CHR$(10) THEN EXIT wait_enter
2256     ph = 1 - ph : CALL base+20, rb, ph
2258   END REPeat wait_enter
2260   CLS : CLS #2
2270 END DEFine
