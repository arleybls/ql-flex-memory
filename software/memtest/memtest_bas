610 REMark find the card's window: probe 32K blocks above the QDOS RAM top
620 DEFine PROCedure detect_win
630   LOCal a, ramt
640   ws = 0 : we = 0
650   ramt = PEEK_L(sysbase+32)
660   a = ramt : IF a < 262144 THEN a = 262144
670   REPeat find_start
680     IF a >= 1048576 THEN EXIT find_start
690     IF blk_ram(a) THEN ws = a : EXIT find_start
700     a = a + 32768
710   END REPeat find_start
720   IF ws = 0 THEN RETurn
730   we = ws + 32768
740   REPeat find_end
750     IF we >= 1048576 THEN EXIT find_end
760     IF NOT blk_ram(we) THEN EXIT find_end
770     we = we + 32768
780   END REPeat find_end
790 END DEFine
800 :
810 DEFine FuNction win$(s, e)
820   IF s = 262144 AND e = 786432 THEN RETurn " (512K)"
830   IF s = 786432 AND e = 1048576 THEN RETurn " (+256K)"
840   IF s = 786432 AND e = 983040 THEN RETurn " (+192K)"
850   IF s = 786432 AND e = 917504 THEN RETurn " (+128K)"
860   IF s = 819200 AND e = 1048576 THEN RETurn " (+256K TRUMP)"
870   IF s = 819200 AND e = 983040 THEN RETurn " (+192K TRUMP)"
880   IF s = 819200 AND e = 917504 THEN RETurn " (+128K TRUMP)"
890   RETurn ""
900 END DEFine
